<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>🎮 AGP STORE — Aktifkan VIP</title>
    <style>
        *{margin:0;padding:0;box-sizing:border-box;font-family:'Segoe UI',Arial,sans-serif;}
        body{background:linear-gradient(135deg,#1a1a2e,#16213e);min-height:100vh;padding:25px 18px;}
        .container{max-width:480px;margin:0 auto;}
        .logo{text-align:center;color:white;font-size:26px;font-weight:bold;margin-bottom:5px;}
        .logo span{color:#f59e0b;}
        .sub-logo{text-align:center;color:#9ca3af;font-size:13px;margin-bottom:25px;}
        .card{background:white;border-radius:20px;padding:28px;box-shadow:0 10px 40px rgba(0,0,0,0.3);}
        .card h2{text-align:center;color:#1f2937;margin-bottom:22px;font-size:21px;}
        .produk-box{background:linear-gradient(135deg,#fffbeb,#fef3c7);border:2px solid #fcd34d;border-radius:14px;padding:20px;margin-bottom:22px;text-align:center;}
        .produk-nama{font-size:20px;font-weight:bold;color:#92400e;margin-bottom:8px;}
        .produk-desc{color:#78350f;font-size:14px;margin-bottom:12px;}
        .produk-harga{font-size:26px;font-weight:bold;color:#b45309;}
        .info-box{background:#f3f4f6;border-radius:12px;padding:18px;margin-bottom:22px;}
        .info-row{display:flex;justify-content:space-between;padding:7px 0;border-bottom:1px dashed #ddd;}
        .info-row:last-child{border-bottom:none;}
        .info-label{color:#6b7280;font-size:14px;}
        .info-value{color:#111827;font-weight:600;font-size:14px;word-break:break-all;}
        .info-value.highlight{color:#d97706;font-weight:bold;}
        .form-group{margin-bottom:16px;}
        .form-group label{display:block;color:#374151;font-weight:600;margin-bottom:7px;font-size:14px;}
        .form-group input,.form-group select{width:100%;padding:13px 15px;border:2px solid #e5e7eb;border-radius:10px;font-size:14px;transition:0.2s;}
        .form-group input:focus,.form-group select:focus{outline:none;border-color:#f59e0b;box-shadow:0 0 0 3px rgba(245,158,11,0.2);}
        .btn-beli{width:100%;background:linear-gradient(135deg,#f59e0b,#d97706);color:white;border:none;padding:16px;font-size:18px;font-weight:bold;border-radius:12px;cursor:pointer;transition:0.3s;margin-top:8px;}
        .btn-beli:hover{transform:translateY(-2px);box-shadow:0 6px 20px rgba(217,119,6,0.35);}
        .btn-beli:disabled{background:#ccc;cursor:not-allowed;transform:none;}
        .metode{margin-top:18px;}
        .metode h4{color:#374151;margin-bottom:10px;font-size:15px;}
        .metode-list{display:grid;grid-template-columns:repeat(3,1fr);gap:10px;}
        .metode-item{border:2px solid #e5e7eb;border-radius:10px;padding:12px 6px;text-align:center;cursor:pointer;transition:0.2s;font-size:12px;}
        .metode-item.aktif{border-color:#f59e0b;background:#fffbeb;font-weight:600;}
        .footer{text-align:center;color:#9ca3af;font-size:12px;margin-top:22px;}
        .footer a{color:#f59e0b;text-decoration:none;}
        .loading{text-align:center;padding:14px;color:#f59e0b;display:none;}
        .sukses-box{background:#ecfdf5;border:2px solid #10b981;border-radius:14px;padding:25px;text-align:center;display:none;}
        .sukses-ikon{font-size:40px;margin-bottom:10px;}
        .vip-aktif{color:#059669;font-weight:bold;font-size:18px;margin:10px 0;}
        .kadaluarsa{color:#6b7280;font-size:14px;margin-top:5px;}
    </style>
</head>
<body>

<div class="container">
    <div class="logo">AGP <span>STORE</span></div>
    <div class="sub-logo">🎮 Beli VIP — Langsung Aktif di Aplikasi</div>

    <div class="card" id="formKartu">
        <h2>🛒 Aktifkan VIP Booster</h2>

        <div class="produk-box">
            <div class="produk-nama">🚀 GAME BOOSTER PREMIUM</div>
            <div class="produk-desc">Sesuai Device ID — Langsung Aktif</div>
            <div class="produk-harga" id="hargaProduk">Pilih Paket →</div>
        </div>

        <div class="info-box">
            <div class="info-row">
                <span class="info-label">🏪 Toko</span>
                <span class="info-value">AGP STORE</span>
            </div>
            <div class="info-row">
                <span class="info-label">📱 Device ID</span>
                <span class="info-value highlight" id="deviceIdTampil">-</span>
            </div>
            <div class="info-row">
                <span class="info-label">📦 No. Pesanan</span>
                <span class="info-value" id="noPesanan">-</span>
            </div>
        </div>

        <form id="formBeli">
            <div class="form-group">
                <label for="deviceId">📱 Device ID (Salin dari Aplikasi)</label>
                <input type="text" id="deviceId" placeholder="Contoh: a1b2c3d4e5f6g7h8" required oninput="updateDeviceId()">
                <small style="color:#6b7280">Buka aplikasi → cari Device ID → salin ke sini</small>
            </div>

            <div class="form-group">
                <label for="paket">📋 Pilih Durasi VIP</label>
                <select id="paket" required onchange="updateHarga()">
                    <option value="">-- Pilih Paket --</option>
                    <option value="15000" menit="1440">⚡ Harian — Rp 15.000 (1 Hari)</option>
                    <option value="40000" menit="10080">🔥 Mingguan — Rp 40.000 (7 Hari)</option>
                    <option value="100000" menit="43200">👑 Bulanan — Rp 100.000 (30 Hari)</option>
                    <option value="250000" menit="52560000">💎 VIP Selamanya — Rp 250.000</option>
                </select>
            </div>

            <div class="form-group">
                <label for="nama">👤 Nama Lengkap</label>
                <input type="text" id="nama" placeholder="Nama pembeli" required>
            </div>

            <div class="form-group">
                <label for="wa">📞 No. WhatsApp</label>
                <input type="tel" id="wa" placeholder="+62 8xx-xxxx-xxxx" required>
            </div>

            <div class="metode">
                <h4>💳 Cara Bayar</h4>
                <div class="metode-list">
                    <div class="metode-item aktif" data-metode="DANA" onclick="pilihMetode(this)">DANA</div>
                    <div class="metode-item" data-metode="QRIS" onclick="pilihMetode(this)">QRIS</div>
                    <div class="metode-item" data-metode="Bank" onclick="pilihMetode(this)">Transfer</div>
                </div>
            </div>

            <input type="hidden" id="metodeBayar" value="DANA">
            <input type="hidden" id="durasiMenit" value="0">

            <button type="submit" class="btn-beli" id="btnBeli">✅ Bayar & Aktifkan VIP</button>
            <div class="loading" id="loading">⏳ Sedang diproses...</div>
        </form>
    </div>

    <div class="card" id="kartuSukses" style="display:none;">
        <div class="sukses-box">
            <div class="sukses-ikon">✅</div>
            <h3>Pembayaran Berhasil!</h3>
            <div class="vip-aktif">🎉 VIP SUDAH AKTIF</div>
            <p>Device ID: <span id="suksesDeviceId" style="word-break:break-all;"></span></p>
            <p>Paket: <span id="suksesPaket"></span></p>
            <p class="kadaluarsa">Berlaku sampai: <span id="suksesSampai"></span></p>
            <p style="color:#059669;margin-top:10px;">✅ Buka aplikasi — langsung VIP!</p>
            <button class="btn-beli" style="margin-top:20px;" onclick="kembaliBeli()">🛒 Beli Lagi</button>
        </div>
    </div>

    <div class="footer">
        Cek langsung di aplikasi • Hubungi: <a href="https://wa.me/6281234567890" target="_blank">+62 812-3456-7890</a><br>
        © 2026 AGP STORE 🔒
    </div>
</div>

<script>
// ==============================================
// 🔑 ISI DATA KAMU DI BAWAH
// ==============================================
const MERCHANT_CODE = "ISI_MERCHANT_KAMU";   // Ganti dari NasionalPay
const API_KEY       = "SK_53ba59ca07b8e1514afe4d1bac4e156b470667005a191f3f26dae53637";     // Ganti dari NasionalPay
const NO_WA_TOKO    = "6285198334953";        // Ganti nomor WA toko

// 🔥 FIREBASE — GANTI DENGAN MILIKMU
const FIREBASE_URL   = "https://NAMA-PROYEK.firebaseio.com/devices"; // ← Ganti!

const HALAMAN_INI   = window.location.href.split('?')[0];
let selectedMetode = "DANA";

// ==============================================
// 📋 FUNGSI TAMPILAN
// ==============================================
function buatNoPesanan() { return "AGP-" + Date.now(); }
function updateDeviceId() { 
    document.getElementById('deviceIdTampil').textContent = document.getElementById('deviceId').value || "-"; 
}
function updateHarga() {
    const s = document.getElementById('paket');
    document.getElementById('hargaProduk').textContent = new Intl.NumberFormat('id-ID',{style:'currency',currency:'IDR'}).format(s.value||0);
    document.getElementById('durasiMenit').value = s.selectedOptions[0].getAttribute('menit');
}
function pilihMetode(e){
    document.querySelectorAll('.metode-item').forEach(i=>i.classList.remove('aktif'));
    e.classList.add('aktif');
    selectedMetode = e.dataset.metode;
}
function formatTanggalMs(ms) {
    return new Date(ms).toLocaleDateString('id-ID', {
        day:'numeric', month:'long', year:'numeric',
        hour:'2-digit', minute:'2-digit'
    });
}
function tampilSukses(deviceId, paket, sampaiMs) {
    document.getElementById('formKartu').style.display='none';
    document.getElementById('kartuSukses').style.display='block';
    document.getElementById('suksesDeviceId').textContent = deviceId;
    document.getElementById('suksesPaket').textContent = paket;
    document.getElementById('suksesSampai').textContent = sampaiMs >= 9999999999999 ? 'Selamanya' : formatTanggalMs(sampaiMs);
}
function kembaliBeli() {
    document.getElementById('formKartu').style.display='block';
    document.getElementById('kartuSukses').style.display='none';
    document.getElementById('formBeli').reset();
    document.getElementById('noPesanan').textContent = buatNoPesanan();
    document.getElementById('deviceIdTampil').textContent = "-";
    document.getElementById('hargaProduk').textContent = "Pilih Paket →";
}

// ==============================================
// 🔥 SIMPAN KE FIREBASE — STRUKTUR SAMA PERSIS DENGAN APLIKASI
// ==============================================
async function simpanKeFirebase(deviceId, durasiMenit, noPesanan, namaPaket, nominal, namaPembeli, wa) {
    const nowMillis = Date.now();
    const expiredMillis = nowMillis + (durasiMenit * 60 * 1000); // menit → milidetik

    // ✅ STRUKTUR SAMA PERSIS DENGAN KODE APLIKASI KAMU!
    const data = {
        allowed: true,              // ← VIP AKTIF
        registeredAt: nowMillis,    // ← waktu daftar
        expiredAt: expiredMillis,   // ← waktu habis (ms)
        noPesanan: noPesanan,       // tambahan
        namaPaket: namaPaket,       // tambahan
        namaPembeli: namaPembeli,   // tambahan
        wa: wa                      // tambahan
    };

    // Kirim ke: /devices/{deviceId}.json
    const url = `${FIREBASE_URL}/${encodeURIComponent(deviceId)}.json`;
    
    const res = await fetch(url, {
        method: 'PUT',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(data)
    });

    if (!res.ok) throw new Error("Gagal simpan ke Firebase");
    return { expiredMillis };
}

// ==============================================
// 🚀 PROSES PEMBELIAN
// ==============================================
document.getElementById('formBeli').addEventListener('submit', async e => {
    e.preventDefault();
    
    const deviceId = document.getElementById('deviceId').value.trim();
    const paket = document.getElementById('paket');
    const nominal = paket.value;
    const durasiMenit = parseInt(document.getElementById('durasiMenit').value);
    const namaPaket = paket.selectedOptions[0].text;
    const nama = document.getElementById('nama').value.trim();
    const wa = document.getElementById('wa').value.trim();

    if (!deviceId || !nominal || !nama || !wa) {
        return alert("⚠️ Lengkapi semua data! Device ID harus sama dengan di aplikasi.");
    }

    const noPesanan = buatNoPesanan();
    document.getElementById('noPesanan').textContent = noPesanan;
    document.getElementById('deviceIdTampil').textContent = deviceId;

    // Simpan sementara
    sessionStorage.setItem('data_bayar', JSON.stringify({
        deviceId, durasiMenit, namaPaket, noPesanan, nominal, nama, wa
    }));

    // Arahkan ke pembayaran
    const signature = btoa(MERCHANT_CODE + API_KEY + noPesanan + nominal);
    const params = new URLSearchParams({
        merchant: MERCHANT_CODE,
        order_id: noPesanan,
        amount: nominal,
        product: `Beli: ${namaPaket} | DeviceID: ${deviceId}`,
        buyer: nama,
        phone: wa,
        return: HALAMAN_INI + `?ok=1&order=${noPesanan}`,
        signature: signature
    });

    window.location.href = "https://nasionalpay.com/pay?" + params;
});

// ==============================================
// ✅ KEMBALI DARI PEMBAYARAN → SIMPAN LANGSUNG
// ==============================================
window.addEventListener('load', async () => {
    const p = new URLSearchParams(window.location.search);
    if (p.get('ok') === '1' && p.get('order')) {
        const data = JSON.parse(sessionStorage.getItem('data_bayar') || '{}');
        
        if (data.noPesanan === p.get('order')) {
            try {
                document.getElementById('btnBeli').disabled = true;
                document.getElementById('loading').style.display = 'block';
                
                // 🔥 Simpan ke Firebase — struktur sama persis!
                const hasil = await simpanKeFirebase(
                    data.deviceId,
                    data.durasiMenit,
                    data.noPesanan,
                    data.namaPaket,
                    data.nominal,
                    data.nama,
                    data.wa
                );
                
                tampilSukses(data.deviceId, data.namaPaket, hasil.expiredMillis);
                sessionStorage.removeItem('data_bayar');
            } catch (err) {
                alert("⚠️ Gagal simpan: " + err.message + "\nHubungi admin.");
            } finally {
                document.getElementById('loading').style.display = 'none';
            }
        }
    } else {
        document.getElementById('noPesanan').textContent = buatNoPesanan();
    }
});
</script>

</body>
</html>
